# PostgreSQL connection
DATABASE_URL=postgresql://news_cc:CHANGE_ME@localhost:5432/news_cc

# Random hex string, generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_hex

# Server port
PORT=3000

# Path to built frontend (dist folder dari `bun run build` di project Lovable)
FRONTEND_DIST=./public

# Cookie domain (kosongkan untuk localhost; isi domain untuk produksi)
COOKIE_DOMAIN=

# Set ke "production" di server
NODE_ENV=development